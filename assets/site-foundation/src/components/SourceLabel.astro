---
import LocalizedText from './LocalizedText.astro';
import { getPrimaryCopy, labelTranslations } from '../lib/localization';
import site from '../site.config.mjs';
const keys: Record<string, string> = {
  open: 'sourceOpen',
  private: 'sourcePrivate',
  mixed: 'sourceMixed',
  'not-applicable': 'sourceNotApplicable',
};
interface Props { value: keyof typeof keys }
const { value } = Astro.props;
const key = keys[value];
const primary = getPrimaryCopy(site).labels[key];
---
<span class="fact-label"><LocalizedText primary={primary} translations={labelTranslations(site, key)} /></span>
